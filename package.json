{
  "name": "uscard-badge-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @uscard/web",
    "build": "npm run typecheck && npm run build --workspace @uscard/web && npm run verify:build",
    "preview": "npm run preview --workspace @uscard/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
